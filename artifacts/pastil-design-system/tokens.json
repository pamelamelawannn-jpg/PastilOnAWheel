{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f8f4ed", "$description": "Warm paper background used for the tracker canvas." },
      "foreground": { "$value": "#31161e", "$description": "Deep berry text for strong contrast." },
      "border": { "$value": "#e2d8cb" },
      "card": { "$value": "#fcfbf7" },
      "cardForeground": { "$value": "#31161e" },
      "popover": { "$value": "#fcfbf7" },
      "popoverForeground": { "$value": "#31161e" },
      "primary": {
        "$value": "#a32431",
        "$description": "Chili red brand color. Drives primary actions, links, and emphasis."
      },
      "primaryForeground": { "$value": "#fcfbf7" },
      "secondary": { "$value": "#e4c686", "$description": "Saffron secondary color for warmth, highlights, and quick status." },
      "secondaryForeground": { "$value": "#31161e" },
      "muted": { "$value": "#ebe5db" },
      "mutedForeground": { "$value": "#7e5d67" },
      "accent": { "$value": "#35695e", "$description": "Leaf green accent for positive values and synced states." },
      "accentForeground": { "$value": "#fcfbf7" },
      "destructive": { "$value": "#b72c1f" },
      "destructiveForeground": { "$value": "#fcfbf7" },
      "input": { "$value": "#e2d8cb" },
      "ring": { "$value": "#a32431" },
      "chart1": { "$value": "#a32431" },
      "chart2": { "$value": "#35695e" },
      "chart3": { "$value": "#e4c686" },
      "chart4": { "$value": "#d97745" },
      "chart5": { "$value": "#7e5d67" },
      "sidebar": { "$value": "#fcfbf7" },
      "sidebarForeground": { "$value": "#31161e" },
      "sidebarBorder": { "$value": "#e2d8cb" },
      "sidebarPrimary": { "$value": "#a32431" },
      "sidebarPrimaryForeground": { "$value": "#fcfbf7" },
      "sidebarAccent": { "$value": "#ebe5db" },
      "sidebarAccentForeground": { "$value": "#31161e" },
      "sidebarRing": { "$value": "#a32431" }
    },
    "dark": {
      "background": { "$value": "#211217" },
      "foreground": { "$value": "#f8f4ed" },
      "border": { "$value": "#453036" },
      "card": { "$value": "#2d1b20" },
      "cardForeground": { "$value": "#f8f4ed" },
      "popover": { "$value": "#2d1b20" },
      "popoverForeground": { "$value": "#f8f4ed" },
      "primary": { "$value": "#e86654" },
      "primaryForeground": { "$value": "#211217" },
      "secondary": { "$value": "#896e34" },
      "secondaryForeground": { "$value": "#f8f4ed" },
      "muted": { "$value": "#3c2a2f" },
      "mutedForeground": { "$value": "#c0b7a5" },
      "accent": { "$value": "#6eb4a5" },
      "accentForeground": { "$value": "#211217" },
      "destructive": { "$value": "#df5043" },
      "destructiveForeground": { "$value": "#211217" },
      "input": { "$value": "#453036" },
      "ring": { "$value": "#e4c686" },
      "chart1": { "$value": "#e86654" },
      "chart2": { "$value": "#6eb4a5" },
      "chart3": { "$value": "#e4c686" },
      "chart4": { "$value": "#e49b6d" },
      "chart5": { "$value": "#c0b7a5" },
      "sidebar": { "$value": "#2d1b20" },
      "sidebarForeground": { "$value": "#f8f4ed" },
      "sidebarBorder": { "$value": "#453036" },
      "sidebarPrimary": { "$value": "#e86654" },
      "sidebarPrimaryForeground": { "$value": "#211217" },
      "sidebarAccent": { "$value": "#3c2a2f" },
      "sidebarAccentForeground": { "$value": "#f8f4ed" },
      "sidebarRing": { "$value": "#e4c686" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "sans-serif"],
        "$description": "Friendly, practical UI and body typeface."
      },
      "serif": { "$value": ["Fraunces", "Georgia", "serif"], "$description": "Expressive display face for headlines and section titles." },
      "mono": { "$value": ["Space Mono", "monospace"], "$description": "Compact numeric face for prices, counts, and operational data." }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1rem",
      "$description": "Soft, friendly base radius; larger surfaces use 22–26px treatments."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Four-pixel rhythm used for compact controls and generous content spacing."
    }
  }
}
